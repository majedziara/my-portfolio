# Canonical production origin. Rebuild after changing the domain.
SITE_URL=https://majed-ziara-portfolio.vercel.app

# Contact form storage. Configure these in your deployment environment.
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=portfolio

# Private server-only key. Generate via npm run admin:setup; never use NEXT_PUBLIC_.
# Copy the same generated value to your deployment environment.
ADMIN_AUTH_SECRET=
